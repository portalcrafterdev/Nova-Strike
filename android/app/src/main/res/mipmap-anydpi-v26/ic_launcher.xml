<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8 and later. Two layers, so the launcher can
     mask them to whatever shape it uses and shift them against each other. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_back" />
    <foreground android:drawable="@mipmap/ic_launcher_fore" />
</adaptive-icon>
