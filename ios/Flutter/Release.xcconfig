#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// google_mobile_ads imports <GoogleMobileAds/GoogleMobileAds_Beta.h>, which the
// GoogleMobileAds xcframework ships under PrivateHeaders/ without listing it in
// either module map. Runner builds that module, so it needs the allowance too.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
